# PhoneLens 环境变量示例 —— 不含真实密钥。复制为 .env.local 后填写。
# 所有变量仅在服务端读取；切勿添加 NEXT_PUBLIC_ 前缀。

# ---- 模型服务（不填则运行“基础模式”，核心比较照常可用） ----
# anthropic | openai_compatible
AI_PROVIDER=anthropic
AI_API_KEY=
# 可选：服务地址，仅由服务端配置，用户无法修改
AI_BASE_URL=
# 例如 claude-sonnet-5-5；不设置时 AI 路径关闭
AI_MODEL=
# 单次调用超时（毫秒）与输出上限
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=900

# ---- 调用总开关 ----
# 设为 false 时，所有付费调用立即关闭（关闭开关）
AI_ENABLED=false

# ---- 共享限流与配额（公开部署时必需） ----
# 未配置时，公开环境不会发出付费请求。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 全站每日调用上限（含自动重试）
AI_DAILY_QUOTA=200
# 单个 IP 每 10 分钟最多请求数
AI_RATE_LIMIT_PER_IP=8

# ---- 仅本地开发 ----
# 设为 true 且 NODE_ENV=development 时，允许在没有共享配额存储的情况下本地调用（只用于调试，部署环境无效）
AI_ALLOW_LOCAL_WITHOUT_QUOTA=false
